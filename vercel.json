{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "python3 code/build_dashboard_v2.py && python3 code/build_scans.py",
  "installCommand": "",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/",
      "destination": "/scans.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "functions": {
    "api/ask.js": {
      "maxDuration": 60
    },
    "api/draft.js": {
      "maxDuration": 60
    },
    "api/propose.js": {
      "maxDuration": 60
    },
    "api/discover.js": {
      "maxDuration": 60
    },
    "api/scans.js": {
      "maxDuration": 20
    },
    "api/sweep.js": {
      "maxDuration": 20
    }
  }
}
