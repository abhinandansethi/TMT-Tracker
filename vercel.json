{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "python3 code/build_dashboard_v2.py",
  "installCommand": "",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/",
      "destination": "/tmt-radar-v2.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
