{
 "schema_version": "2.0",
 "updated": "2026-08-25",
 "scope_note": "Engine v2 registry: per-source adapter configs, fixture-tested. Stratum telecom migrated from v1 (all selectors re-verified against 25-08-2026 fixtures). Strata tech_data/media/perimeter appended after the source-completeness audit.",
 "validation_gates": {
  "date": "must parse against the source's declared date formats; undated rows quarantine unless the source declares undated_ok (document shelves)",
  "url": "item links must sit on the source's allowed_domains; anything else quarantines",
  "title": "8-300 chars after whitespace collapse",
  "dedupe": "sha1(normalised_title + date)[:10]; repeat sightings on other venues land in the sightings table, never as duplicate items",
  "failure_policy": "fetch failure or parse below row_floor = FAILED source; sweep exits non-zero; two consecutive failures = prominent alert"
 },
 "classification": {
  "note": "No tiers. One deterministic split: routine or substantive. Audited by code/audit_routine.py — ledger and regex must agree exactly.",
  "routine_regex": "(?i)assess(es|ed)? (mobile )?network quality|subscription data|performance indicator report|quarterly highlights|panel of auditors|sitting of hon|non-sitting|internship|research associate|vacancy circular|recruitment|seminar|workshop|\\bTSTL\\b|designat(es|ed)\\b.{0,60}\\blaborator|empanel|certificate and internship|declaration of holiday|tender|walk[- ]in[- ]interview|consumer (outreach|awareness) program|consumer education workshop|engagement of (young )?professional|CERT-In (Advisory|Vulnerability Note) CI",
  "deadline_regex": "(?i)(comments?|counter[- ]comments?|last date|due).{0,40}?(\\d{1,2}[-./ ](\\d{1,2}|[A-Za-z]+)[-./ ]\\d{2,4})",
  "memo_types": [
   "rules",
   "direction",
   "order",
   "circular",
   "notification",
   "clarification",
   "regulation",
   "tariff_order",
   "exemption",
   "manual",
   "itsar",
   "gazette_notification"
  ],
  "memo_note": "A memo is drafted for a new, non-routine item whose type is in memo_types. Drafts, consultations, releases, notices and designations do not trigger a memo."
 },
